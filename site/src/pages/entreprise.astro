---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { company, values, timeline } from '../data/site';
---

<Layout title="L'Entreprise" description="SOCARA — Une entreprise indépendante, à taille humaine, ancrée en Alsace depuis 1973. Histoire, valeurs, engagements.">

  <PageHero
    eyebrow="01 — L'Entreprise"
    title="Une entreprise indépendante,"
    titleHighlight="ancrée en Alsace."
    subtitle="Fondée à Strasbourg en 1973, SOCARA est née d'un ancrage fort dans les métiers de terrain. Plus de 50 ans plus tard, nous sommes toujours en mouvement — fidèles à nos fondations."
    image="/img/photos/siege-facade-nuit.jpg"
    variant="dark"
  />

  <!-- INTRO -->
  <Section background="blanc" paddingY="lg">
    <div class="grid-12">
      <div class="col-span-12 lg:col-span-5">
        <p class="section-marker text-rouge mb-8" data-reveal>
          <span>02 — Notre histoire</span>
        </p>
        <h2 class="text-h2 font-display font-extrabold text-anthracite mb-6" data-reveal data-reveal-delay="100">
          L'art de construire, depuis {company.founded}.
        </h2>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7 space-y-5 text-anthracite/85" data-reveal data-reveal-delay="200">
        <p class="text-lede">
          Issue d'une modeste entreprise de carrelage et de crépissage, SOCARA est devenue au fil des décennies un acteur reconnu du gros œuvre, puis de l'entreprise générale, sans jamais perdre son âme&nbsp;: celle d'un bâtisseur humain, engagé, rigoureux.
        </p>
        <p>
          Depuis {company.yearsActive} ans, nous traversons les mutations de la ville, des normes, des techniques… et de la société. Toujours en mouvement, mais fidèle à nos fondations.
        </p>
        <p>
          Chez SOCARA, l'efficacité prime sur la hiérarchie&nbsp;: les circuits sont courts, les échanges directs. C'est ce qui fait notre agilité, notre capacité à répondre vite, bien, et avec exigence.
        </p>
      </div>
    </div>
  </Section>

  <!-- TIMELINE -->
  <Section background="ivoire" paddingY="lg" id="histoire">
    <p class="section-marker text-rouge mb-8" data-reveal>
      <span>03 — Chronologie</span>
    </p>
    <h2 class="text-h2 font-display font-extrabold text-anthracite mb-16 max-w-3xl" data-reveal data-reveal-delay="100">
      Une trajectoire ancrée dans le terrain.
    </h2>

    <ol class="relative">
      <span class="absolute left-[7.5rem] sm:left-[9rem] top-0 bottom-0 w-px bg-rouge/30" aria-hidden="true"></span>
      {timeline.map((item, i) => (
        <li class="relative grid grid-cols-[7.5rem_1fr] sm:grid-cols-[9rem_1fr] gap-6 lg:gap-10 pb-12 lg:pb-16" data-reveal data-reveal-delay={Math.min(i * 50, 400)}>
          <div class="text-right">
            <span class="font-display font-extrabold text-h3 lg:text-h2 text-rouge tabular-nums leading-none">{item.year}</span>
          </div>
          <div class="pl-6 lg:pl-10 relative">
            <span class="absolute left-0 top-3 -translate-x-[0.625rem] block w-5 h-5 rounded-full bg-rouge ring-4 ring-ivoire" aria-hidden="true"></span>
            <h3 class="font-display font-extrabold text-h4 text-anthracite mb-2">{item.title}</h3>
            <p class="text-anthracite/75 max-w-2xl leading-relaxed">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- VALEURS -->
  <Section background="anthracite" paddingY="lg" id="valeurs">
    <div class="grid-12 mb-16">
      <div class="col-span-12 lg:col-span-7">
        <p class="section-marker text-rouge-clair mb-8" data-reveal>
          <span>04 — Nos valeurs</span>
        </p>
        <h2 class="text-h2 font-display font-extrabold text-blanc mb-6" data-reveal data-reveal-delay="100">
          L'humain et le chantier<br />
          <span class="text-rouge-clair">au cœur de notre métier.</span>
        </h2>
      </div>
      <div class="col-span-12 lg:col-span-4 lg:col-start-9 self-end" data-reveal data-reveal-delay="200">
        <p class="text-blanc/80 text-lede">
          Pas des slogans. Des actes concrets, transmis de génération en génération depuis 1973.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-px bg-blanc/15 border border-blanc/15">
      {values.map((v, i) => (
        <li class="bg-anthracite p-8 lg:p-12" data-reveal data-reveal-delay={i * 80}>
          <div class="flex items-start gap-6">
            <span class="font-display font-extrabold text-rouge-clair text-h3 tabular-nums leading-none shrink-0">0{i + 1}</span>
            <div>
              <h3 class="font-display font-extrabold text-h4 text-blanc mb-3">{v.title}</h3>
              <p class="text-blanc/80 leading-relaxed mb-4">{v.body}</p>
              <p class="text-sm italic text-blanc/60 border-l-2 border-rouge-clair pl-4">«&nbsp;{v.quote}&nbsp;»</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <!-- CHIFFRES CLES -->
  <Section background="blanc" paddingY="lg">
    <p class="section-marker text-rouge mb-8" data-reveal>
      <span>05 — Chiffres clés</span>
    </p>
    <h2 class="text-h2 font-display font-extrabold text-anthracite mb-16 max-w-3xl" data-reveal data-reveal-delay="100">
      L'expérience se mesure aussi.
    </h2>

    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-[color:var(--color-border)] border border-[color:var(--color-border)] rounded-md overflow-hidden">
      {[
        { value: company.yearsActive, label: 'Années d\'existence', prefix: '' },
        { value: company.builtCount, label: 'Ouvrages livrés', prefix: '' },
        { value: company.headcount, label: 'Collaborateurs', prefix: '+' },
        { value: 100, label: 'Chefs de chantier formés en interne', prefix: '', suffix: '%' },
      ].map((stat) => (
        <div class="bg-blanc p-8 lg:p-10" data-reveal>
          <dt class="font-label uppercase text-[11px] tracking-[0.18em] text-gris-chaud mb-4">{stat.label}</dt>
          <dd>
            <span
              class="font-display font-extrabold text-rouge text-[clamp(3rem,6vw,5rem)] leading-none tabular-nums tracking-tight"
              data-counter={stat.value}
              data-counter-prefix={stat.prefix ?? ''}
              data-counter-suffix={stat.suffix ?? ''}
            >
              {stat.prefix ?? ''}{stat.value}{stat.suffix ?? ''}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- RSE — sobre, anti-greenwashing -->
  <Section background="ivoire" paddingY="lg" id="rse">
    <div class="grid-12">
      <div class="col-span-12 lg:col-span-7">
        <p class="section-marker text-rouge mb-8" data-reveal>
          <span>06 — Engagements</span>
        </p>
        <h2 class="text-h2 font-display font-extrabold text-anthracite mb-6" data-reveal data-reveal-delay="100">
          Construire mieux, sobrement.
        </h2>
        <p class="text-lede text-anthracite/75 mb-10 max-w-2xl" data-reveal data-reveal-delay="200">
          Nous ne sommes pas champions du monde des labels. Nous appliquons les normes, nous mesurons ce que nous faisons, et nous essayons de faire mieux. Sans slogan.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {[
        { title: 'Normes énergétiques', body: 'BBC, RT2012, RE2020, HQE — intégrées dès la phase amont, pas en bout de chaîne.' },
        { title: 'Gestion des nuisances', body: 'Tri des déchets, propreté chantier, limitation du bruit et des poussières. Mesurable, contrôlable.' },
        { title: 'Sécurité & conditions', body: 'Plateformes sécurisées, équipements, formations continues. La sécurité n\'est pas une option.' },
      ].map((item) => (
        <li class="bg-blanc p-8 rounded-md border border-[color:var(--color-border)]" data-reveal>
          <h3 class="font-display font-extrabold text-h4 text-anthracite mb-3">{item.title}</h3>
          <p class="text-anthracite/75">{item.body}</p>
        </li>
      ))}
    </ul>
  </Section>

</Layout>
