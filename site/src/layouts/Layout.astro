---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = company.baseline, bodyClass = '' } = Astro.props;
const fullTitle = `${title} — ${company.name}`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="theme-color" content="#E30613" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@300;400;600;700;800&display=swap"
  />
</head>
<body class={bodyClass}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-anthracite focus:text-blanc focus:px-4 focus:py-2">
    Aller au contenu
  </a>

  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer />

  <script>
    import { initReveals, initCounters } from '../lib/reveal';
    document.addEventListener('astro:page-load', () => {
      initReveals();
      initCounters();
    });
    // Initial run if no view transitions
    initReveals();
    initCounters();
  </script>
</body>
</html>
