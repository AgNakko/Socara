---
interface Props {
  eyebrow: string;
  title: string;
  /** Optional second-line title rendered in red accent. */
  titleHighlight?: string;
  subtitle?: string;
  image?: string;
  /** Color theme variant for the hero. */
  variant?: 'dark' | 'red' | 'light';
}

const { eyebrow, title, titleHighlight, subtitle, image, variant = 'dark' } = Astro.props;

const bgClass = {
  dark:  'bg-anthracite text-blanc',
  red:   'bg-rouge text-blanc',
  light: 'bg-ivoire text-anthracite',
}[variant];

const eyebrowClass = {
  dark:  'text-rouge-clair',
  red:   'text-blanc/80',
  light: 'text-rouge',
}[variant];

const titleHighlightClass = {
  dark:  'text-rouge-clair',
  red:   'text-anthracite',
  light: 'text-rouge',
}[variant];

const subtitleClass = {
  dark:  'text-blanc/80',
  red:   'text-blanc/85',
  light: 'text-anthracite/75',
}[variant];
---
<section class={`relative overflow-hidden ${bgClass}`}>
  {image && (
    <div class="absolute inset-0" aria-hidden="true">
      <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-50" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-br from-anthracite/85 via-anthracite/55 to-rouge/35"></div>
    </div>
  )}

  <div class="container-prose relative pt-[140px] pb-24 lg:pt-[180px] lg:pb-32 min-h-[58vh] flex flex-col justify-end">
    <p class:list={["section-marker mb-8", eyebrowClass]} data-reveal>
      <span>{eyebrow}</span>
    </p>
    <h1 class="text-h1 lg:text-display font-display font-extrabold mb-6 max-w-5xl" data-reveal data-reveal-delay="100">
      <span class="block">{title}</span>
      {titleHighlight && <span class:list={["block", titleHighlightClass]}>{titleHighlight}</span>}
    </h1>
    {subtitle && (
      <p class:list={["text-lede max-w-2xl", subtitleClass]} data-reveal data-reveal-delay="200">
        {subtitle}
      </p>
    )}
  </div>
</section>
